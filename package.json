{
  "name": "irvrun",
  "displayName": "IrvRun",
  "description": "Run MASM32 Assembly code using Irvine32 with one click.",
  "version": "1.2.0",
  "publisher": "lebelokamogelo",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lebelokamogelo/IrvRun.git"
  },
  "engines": {
    "vscode": "^1.56.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "masm",
    "irvine32",
    "assembly",
    "runner"
  ],
  "main": "./out/src/extension",
  "activationEvents": [
    "onLanguage:asm"
  ],
  "contributes": {
    "commands": [
      {
        "command": "irvrun.run",
        "title": "Run MASM Code",
        "category": "IrvRun",
        "icon": "$(play)"
      },
      {
        "command": "irvrun.build",
        "title": "Build MASM Code",
        "category": "IrvRun"
      },
      {
        "command": "irvrun.clean",
        "title": "Clean Build Files",
        "category": "IrvRun"
      },
      {
        "command": "irvrun.checkSetup",
        "title": "Check Setup",
        "category": "IrvRun"
      },
      {
        "command": "irvrun.newFile",
        "title": "New Program",
        "category": "IrvRun"
      },
      {
        "command": "irvrun.insertGame",
        "title": "Insert Game",
        "category": "IrvRun"
      },
      {
        "command": "irvrun.cheatSheet",
        "title": "Open Cheat Sheet",
        "category": "IrvRun"
      }
    ],
    "configuration": {
      "title": "IrvRun",
      "properties": {
        "irvrun.masmPath": {
          "type": "string",
          "default": "C:\\Masm615",
          "description": "Path to your MASM615 installation (the folder containing ml.exe, link.exe, and make32.bat)."
        },
        "irvrun.pauseAfterRun": {
          "type": "boolean",
          "default": true,
          "description": "Keep the console open after the program finishes by pausing until a key is pressed."
        }
      }
    },
    "keybindings": [
      {
        "command": "irvrun.run",
        "key": "ctrl+alt+n",
        "when": "editorLangId == asm"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "irvrun.run",
          "when": "resourceExtname == .asm",
          "group": "navigation"
        },
        {
          "command": "irvrun.build",
          "when": "resourceExtname == .asm",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "command": "irvrun.run",
          "when": "resourceExtname == .asm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "irvrun.run",
          "when": "resourceExtname == .asm",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "irvrun",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The IrvRun task to run."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "asm",
        "extensions": [
          ".asm"
        ],
        "aliases": [
          "Irvine32",
          "MASM",
          "asm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asm",
        "scopeName": "source.asm",
        "path": "./syntaxes/masm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "asm",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.56.0",
    "typescript": "^5.9.2"
  }
}
