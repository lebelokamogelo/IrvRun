{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "'", "close": "'", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z_@$?][A-Za-z0-9_@$?]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[A-Za-z_@$?][\\w@$?]*\\s+PROC\\b.*$",
    "decreaseIndentPattern": "^\\s*[A-Za-z_@$?][\\w@$?]*\\s+ENDP\\b.*$"
  }
}
